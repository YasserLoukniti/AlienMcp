{
  "manifest_version": 3,
  "name": "AlienMcp - Browser Automation for AI",
  "version": "1.2.0",
  "description": "Let your local AI assistant drive your browser: read pages, click, fill forms, screenshot. Runs entirely on your machine.",
  "permissions": [
    "tabs",
    "scripting",
    "debugger",
    "storage",
    "alarms",
    "tabGroups",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AlienMcp"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; connect-src 'self' ws://localhost:* http://localhost:*; object-src 'none';"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
